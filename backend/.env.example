# Laravel environment.
#
# Local development:  copy to .env, set the DB_* values, run `php artisan key:generate`.
# Production (Hostinger): the real .env lives only on the server (see DEPLOYMENT.md) and is
# never committed or overwritten by a deploy.

APP_NAME="Your Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Public address of the site: used for the sitemap, canonical links and social previews.
SITE_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL / MariaDB. On Hostinger use the database name, user and password from hPanel
# (they look like u123456789_shop).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shop
DB_USERNAME=root
DB_PASSWORD=

# No Redis, queues or database-backed sessions are needed on shared hosting.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# After your-domain.com is live, set this to true so the old test address and www. redirect to SITE_URL.
# FORCE_CANONICAL_HOST=true

# Paid add-ons (off by default; the vendor switches one on, then runs `php artisan config:cache`).
# Offline shop: Quick sell by barcode, barcode and piece labels, shop customers, online vs shop reports.
# FEATURE_OFFLINE_SHOP=true

# Uploaded pictures and videos are stored in the website's own media folder (<site>/media). Git never touches it, so a
# deploy keeps every upload. There is nothing to configure.

# Google reCAPTCHA v3 secret key (the public site key is set in Admin -> Integrations).
# RECAPTCHA_SECRET_KEY=

# These keys can also be entered in the admin (Integrations, main administrator only), where they are stored encrypted.
# Values saved in the admin win over the ones here. Online payments (Razorpay). Get the keys from the Razorpay dashboard, then switch on
# "Online payment" in Admin -> Settings -> Store features.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when adding the webhook in Razorpay (Settings -> Webhooks). URL: <your site>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# --- The store's identity (read by the SEO tags, e-mails, product feed, robots.txt and the web app) ---
# Set these for each site. Anything left out falls back to the defaults in config/brand.php.
# BRAND_NAME="Your Store"
# BRAND_TAGLINE="Premium jewellery for every moment"
# BRAND_DESCRIPTION="One sentence about the store (default page description)."
# BRAND_FOUNDED_LABEL="Est. July 2026"
# BRAND_PHONE_DISPLAY="+91 75748 80807"
# BRAND_PHONE_E164=917574880807
# BRAND_SUPPORT_EMAIL=support@your-domain.com
# BRAND_ORDERS_EMAIL=orders@your-domain.com
# BRAND_INSTAGRAM_HANDLE=@yourstore
# BRAND_INSTAGRAM_URL=https://www.instagram.com/yourstore/
# BRAND_FACEBOOK_LABEL=YourStore
# BRAND_FACEBOOK_URL=https://www.facebook.com/YourStore
# Money, dates and place (online payments run in rupees, so change the currency only together with the payment gateway):
# BRAND_CURRENCY_SYMBOL=₹
# BRAND_CURRENCY_CODE=INR
# BRAND_LOCALE=en-IN
# BRAND_TIMEZONE=Asia/Kolkata
# BRAND_COUNTRY=India

# Order e-mails. The main administrator can instead add mail accounts in Admin -> Emails -> Mail servers (they win over these).
# Use your Hostinger mailbox SMTP details, e.g. smtp.hostinger.com, port 465 / 587.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=orders@your-domain.com
# MAIL_PASSWORD=
# MAIL_SCHEME=smtps
# MAIL_FROM_ADDRESS=orders@your-domain.com
# MAIL_FROM_NAME="Your Store"
# ORDER_NOTIFY_EMAIL=orders@your-domain.com

# External storefront API (add-on): lets a client's own website read this catalogue and post its orders here.
# Off unless set to true. STOREFRONT_API_ORIGINS lists the websites allowed to call it, comma separated.
FEATURE_EXTERNAL_STOREFRONT=false
STOREFRONT_API_ORIGINS=
STOREFRONT_API_PHONE_EMAIL_DOMAIN=phone.invalid
